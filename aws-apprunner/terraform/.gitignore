# Local .terraform directories
.terraform/

# State files
*.tfstate
*.tfstate.*
*.tfstate.*.backup
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude sensitive files
*.tfvars
*.tfvars.json

# Allow example files
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Plan files
*tfplan*

# Explicitly keep lock files
!.terraform.lock.hcl
